---
# INSTRUCTIONS:
# 1. Copy this file to users.yml: `cp users.yml.example users.yml`
# 2. Edit users.yml with your actual users and optionally their SSH keys
# 3. users.yml is gitignored and will not be checked into version control
#
# Additional users to create on the system (excluding primary user)
# The primary user is already created by cloud-init during VM provisioning
# and is defined in tf/host_users.auto.tfvars
#
# Users are tracked via the 'ansible-added' group. If you remove a user, you will
# need to manually remove them from the host; including `/etc/sudoers.d/` file.
#
# Users can be authorised to log in via opkssh (OpenPubkey SSH).
# Each entry maps a Linux user (above or the primary user) to an identity
# claim from the OIDC provider, usually their email address.
#
# Example:
#
#  Alice has a opkssh_claim_selector (`email` claim, but can be `sub`) AND a static_ssh_key, Bob just has the former
#
# additional_users:
#   - name: alice
#     opkssh_claim_selector: alice@example.com
#     static_ssh_key: "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... alice@example.com"
#   - name: bob
#     opkssh_claim_selector: bob@example.com
#     static_ssh_key: ""


additional_users: []
