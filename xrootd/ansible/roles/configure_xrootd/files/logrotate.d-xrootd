/var/log/xrootd/*/*.log /var/log/xrootd/*.log
{
  # if the xrootd log rotate is enabled don't do anything
  # (by convention if xrootd log rotate is enabled the
  # .lock file exists)

  # Replace the original e.g. from https://github.com/xrootd/xrootd/blob/v5.9.2/packaging/common/xrootd.logrotate
  # switch to copytruncate after we found logs were missing on uksrc-cam-prod-xrootd after rotation

  prerotate
    LOCK=`dirname $1`/.lock
    if [ -f $LOCK ]; then
      exit 1
    else
      exit 0
    fi
  endscript
  dateext
  missingok
  nomail
  copytruncate
  rotate 100
  notifempty
  daily
  compress
}
