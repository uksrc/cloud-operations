# PostgreSQL Database User Passwords and Other Secrets
# Copy this file to .env and set your actual passwords
# The .env file is gitignored for security

# PostgreSQL superuser password - admin for all databases on the server
export POSTGRES_PASSWORD="changeme-postgres"

# Content Admin password (used by torkeep service)
export CAOM_ADMIN_PASSWORD="changeme-cadmin"

# TAP Admin password (used by argus service)
export CAOM_TAP_ADMIN_PASSWORD="changeme-tapadm"

# TAP User password (used by argus service for user queries)
export CAOM_TAP_USER_PASSWORD="changeme-tapuser"

# Slack webhook to push VM restart required notifications
export SLACK_WEBHOOK_URL=""
