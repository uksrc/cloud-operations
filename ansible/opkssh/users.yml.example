---
# INSTRUCTIONS:
# 1. Copy this file to users.yml: cp users.yml.example users.yml
# 2. Edit users.yml with the users to authorise on the server
# 3. users.yml is gitignored and will not be checked into version control
#
# Each entry authorises a Linux user on the host to log in via opkssh by
# mapping the username to a claim from the OIDC provider (usually the
# user's email address).
#
# The Linux users must already exist on the host (e.g. created by the
# manage_users playbook or cloud-init). Removing a user here stops them
# logging in via opkssh, but does not remove the account from the host.
#
# Format:
#   - name: <linux username>
#     opkssh_claim_selector: <email|sub|group from the OIDC token>
#     opkssh_provider: <provider key>   # optional, defaults to the first
#                                       # provider in opkssh_providers
#
# Example:
# opkssh_auth_id:
#   - name: jane
#     opkssh_claim_selector: jane@example.com
#   - name: john
#     opkssh_claim_selector: john@example.com

opkssh_auth_id: []
