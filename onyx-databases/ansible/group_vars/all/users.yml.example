---
# INSTRUCTIONS:
# 1. Copy this file to users.yml: cp users.yml.example users.yml
# 2. Edit users.yml with your actual user SSH keys
# 3. users.yml is gitignored and will not be checked into version control
#
# Additional users to create on the system (excluding primary user)
# The primary user is already created by cloud-init during VM provisioning
# and is defined in tf/host_users.auto.tfvars
#
# Users are tracked via the 'ansible-managed' group. If you remove a user
# from this list and re-run the playbook, that user will be automatically
# removed from the system (including their home directory).
#
# Format:
#   username: "ssh-rsa AAAAB3... user@host"
#
# Example:
# additional_users:
#   alice: "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... alice@example.com"
#   bob: "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACAQ... bob@example.com"
#
# Deploy changes with:
#   cd ansible
#   ansible-playbook -i inventory manage_users.yml

additional_users: {}
