# PostgreSQL Database User Passwords and Other Secrets
# Copy this file to .env and set your actual passwords
# The .env file is gitignored for security

# PostgreSQL superuser password - admin for all databases on the server
export POSTGRES_PASSWORD="changeme-postgres"

# CAOM database
export CAOM_ADMIN_PASSWORD="changeme-caom-admin"
export CAOM_TAP_ADMIN_PASSWORD="changeme-caom-tap-admin"
export CAOM_TAP_USER_PASSWORD="changeme-caom-tap-user"

# SDS database
export SDS_PREPROD_ADMIN_PASSWORD="changeme-sds-admin"
export SDS_PREPROD_TAP_ADMIN_PASSWORD="changeme-sds-tap-admin"
export SDS_PREPROD_TAP_USER_PASSWORD="changeme-sds-tap-user"
export SDS_ADMIN_PASSWORD="changeme-sds-admin"
export SDS_TAP_ADMIN_PASSWORD="changeme-sds-tap-admin"
export SDS_TAP_USER_PASSWORD="changeme-sds-tap-user"

# Slack webhook to push VM restart required notifications
export SLACK_WEBHOOK_URL=""
